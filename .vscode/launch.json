    "version": "0.2.0",
    "configurations": [
        {
            "name": "sudo debug",
            "type": "debugpy",
            "request": "launch",
            "module": "mbctl",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "python": "sudo",
            "pythonArgs": [ "PYTHONPATH=${workspaceFolder}/src" , "${command:python.interpreterPath}"]
        },
        {
            "name": "debug list",
            "type": "debugpy",
            "request": "launch",
            "module": "mbctl",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": ["list"],
            "python": "${command:python.interpreterPath}"
        }
    ]
}